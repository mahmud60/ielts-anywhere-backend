[Unit]
Description=IELTS Celery Worker (writing grading + improvement-tip feedback tasks)
After=network-online.target
Wants=network-online.target
# Never give up restarting, even during a long broker outage. Without this,
# systemd's default burst limit (5 restarts / 10s) would mark the service
# "failed" and stop trying — defeating the whole point of auto-recovery.
StartLimitIntervalSec=0

[Service]
Type=simple
User=MAHMUD
WorkingDirectory=/home/MAHMUD/ielts-anywhere-backend
# Broker/DB/AI settings (REDIS_URL, DATABASE_URL, ANTHROPIC_API_KEY, …) are read
# from .env in WorkingDirectory by pydantic-settings when celery_app is imported.
# Installed via `pip3 install --user`, so the entrypoint lives in ~/.local/bin.
ExecStart=/home/MAHMUD/.local/bin/celery -A app.tasks.grading.celery_app worker --loglevel=info --concurrency=2

# Auto-restart on crash, OOM, or VM reboot — the fix that matters here: a broker
# blip raises an unrecoverable error that EXITS the worker, and the old nohup
# process then stayed dead until the next deploy, silently halting ALL writing
# grading and feedback. systemd brings it straight back and it reconnects.
Restart=always
RestartSec=5

# Logs go to the systemd journal — view with:
#   journalctl -u ielts-celery -f

[Install]
WantedBy=multi-user.target
